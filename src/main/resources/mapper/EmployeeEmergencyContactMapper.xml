<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.study11.dao.EmployeeEmergencyContactDao">

    <resultMap id="EmployeeEmergencyContactMap" type="com.example.study11.entity.po.EmployeeEmergencyContactPo">
        <id property="id" column="id"/>
        <result property="employeeUuid" column="employee_uuid"/>
        <result property="sortNo" column="sort_no"/>
        <result property="fullName" column="full_name"/>
        <result property="relationship" column="relationship"/>
        <result property="address" column="address"/>
        <result property="postalCode" column="postal_code"/>
        <result property="phone" column="phone"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumnList">
        id, employee_uuid, sort_no, full_name, relationship, address, postal_code, phone,
        created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.example.study11.entity.po.EmployeeEmergencyContactPo"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO `employee_emergency_contact`
        (employee_uuid, sort_no, full_name, relationship, address, postal_code, phone,
         created_at, updated_at)
        VALUES
        (#{employeeUuid}, #{sortNo}, #{fullName}, #{relationship}, #{address}, #{postalCode},
         #{phone}, #{createdAt}, #{updatedAt})
    </insert>

    <select id="selectByEmployeeUuid" resultMap="EmployeeEmergencyContactMap">
        SELECT <include refid="BaseColumnList"/>
        FROM `employee_emergency_contact`
        WHERE employee_uuid = #{employeeUuid}
        ORDER BY sort_no ASC, id ASC
    </select>

    <delete id="deleteByEmployeeUuid">
        DELETE FROM `employee_emergency_contact`
        WHERE employee_uuid = #{employeeUuid}
    </delete>
</mapper>
