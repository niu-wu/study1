<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.study11.dao.RetestApplicationDao">

    <resultMap id="RetestApplicationMap" type="com.example.study11.entity.po.RetestApplicationPo">
        <id property="id" column="id"/>
        <result property="recordUuid" column="record_uuid"/>
        <result property="applicationTime" column="application_time"/>
        <result property="applicantRemark" column="applicant_remark"/>
        <result property="applicantUserId" column="applicant_user_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="BaseColumnList">
        id, record_uuid, application_time, applicant_remark, applicant_user_id, created_at
    </sql>

    <insert id="insert" parameterType="com.example.study11.entity.po.RetestApplicationPo"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO `retest_application`
        (record_uuid, application_time, applicant_remark, applicant_user_id)
        VALUES
        (#{recordUuid}, #{applicationTime}, #{applicantRemark}, #{applicantUserId})
    </insert>

    <select id="selectByRecordUuid" resultMap="RetestApplicationMap">
        SELECT <include refid="BaseColumnList"/>
        FROM `retest_application`
        WHERE record_uuid = #{recordUuid}
        ORDER BY id ASC
        LIMIT 1
    </select>
</mapper>
