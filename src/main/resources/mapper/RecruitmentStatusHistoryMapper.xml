<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.study11.dao.RecruitmentStatusHistoryDao">

    <resultMap id="RecruitmentStatusHistoryMap"
               type="com.example.study11.entity.po.RecruitmentStatusHistoryPo">
        <id property="id" column="id"/>
        <result property="recordUuid" column="record_uuid"/>
        <result property="fromStatus" column="from_status"/>
        <result property="toStatus" column="to_status"/>
        <result property="action" column="action"/>
        <result property="operatorUserId" column="operator_user_id"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.study11.entity.po.RecruitmentStatusHistoryPo"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO `recruitment_status_history`
        (record_uuid, from_status, to_status, action, operator_user_id, remark, created_at)
        VALUES
        (#{recordUuid}, #{fromStatus}, #{toStatus}, #{action}, #{operatorUserId}, #{remark}, #{createdAt})
    </insert>

    <select id="countByRecordUuid" resultType="long">
        SELECT COUNT(1)
        FROM `recruitment_status_history`
        WHERE record_uuid = #{recordUuid}
    </select>

    <select id="selectByRecordUuid" resultMap="RecruitmentStatusHistoryMap">
        SELECT id, record_uuid, from_status, to_status, action, operator_user_id, remark, created_at
        FROM `recruitment_status_history`
        WHERE record_uuid = #{recordUuid}
        ORDER BY id ASC
    </select>
</mapper>
