<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.study11.dao.EmployeeWorkHistoryDao">

    <resultMap id="EmployeeWorkHistoryMap" type="com.example.study11.entity.po.EmployeeWorkHistoryPo">
        <id property="id" column="id"/>
        <result property="employeeUuid" column="employee_uuid"/>
        <result property="sortNo" column="sort_no"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="companyName" column="company_name"/>
        <result property="position" column="position"/>
        <result property="leaveReason" column="leave_reason"/>
        <result property="referenceName" column="reference_name"/>
        <result property="referencePhone" column="reference_phone"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumnList">
        id, employee_uuid, sort_no, start_date, end_date, company_name, position,
        leave_reason, reference_name, reference_phone, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.example.study11.entity.po.EmployeeWorkHistoryPo"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO `employee_work_history`
        (employee_uuid, sort_no, start_date, end_date, company_name, position,
         leave_reason, reference_name, reference_phone, created_at, updated_at)
        VALUES
        (#{employeeUuid}, #{sortNo}, #{startDate}, #{endDate}, #{companyName}, #{position},
         #{leaveReason}, #{referenceName}, #{referencePhone}, #{createdAt}, #{updatedAt})
    </insert>

    <select id="selectByEmployeeUuid" resultMap="EmployeeWorkHistoryMap">
        SELECT <include refid="BaseColumnList"/>
        FROM `employee_work_history`
        WHERE employee_uuid = #{employeeUuid}
        ORDER BY sort_no ASC, id ASC
    </select>

    <delete id="deleteByEmployeeUuid">
        DELETE FROM `employee_work_history`
        WHERE employee_uuid = #{employeeUuid}
    </delete>
</mapper>
