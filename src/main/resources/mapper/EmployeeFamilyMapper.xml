<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.study11.dao.EmployeeFamilyDao">

    <resultMap id="EmployeeFamilyMap" type="com.example.study11.entity.po.EmployeeFamilyPo">
        <id property="id" column="id"/>
        <result property="employeeUuid" column="employee_uuid"/>
        <result property="sortNo" column="sort_no"/>
        <result property="fullName" column="full_name"/>
        <result property="relationship" column="relationship"/>
        <result property="workUnit" column="work_unit"/>
        <result property="jobTitle" column="job_title"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="BaseColumnList">
        id, employee_uuid, sort_no, full_name, relationship, work_unit, job_title,
        created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.example.study11.entity.po.EmployeeFamilyPo"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO `employee_family`
        (employee_uuid, sort_no, full_name, relationship, work_unit, job_title,
         created_at, updated_at)
        VALUES
        (#{employeeUuid}, #{sortNo}, #{fullName}, #{relationship}, #{workUnit}, #{jobTitle},
         #{createdAt}, #{updatedAt})
    </insert>

    <select id="selectByEmployeeUuid" resultMap="EmployeeFamilyMap">
        SELECT <include refid="BaseColumnList"/>
        FROM `employee_family`
        WHERE employee_uuid = #{employeeUuid}
        ORDER BY sort_no ASC, id ASC
    </select>

    <delete id="deleteByEmployeeUuid">
        DELETE FROM `employee_family`
        WHERE employee_uuid = #{employeeUuid}
    </delete>
</mapper>
